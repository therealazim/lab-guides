# Required for the Flask backend
DATABASE_URL=postgresql://user:password@host/database
# Use "disable" only for a local Postgres without TLS
DATABASE_SSLMODE=require

# Required for server-backed admin authentication; use strong unique values
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-long-random-password
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Set to true when the site is served over HTTPS
SESSION_COOKIE_SECURE=true

# Admin sessions expire after this many seconds of inactivity
ADMIN_IDLE_SECONDS=3600

# Public site URL used in sitemap.xml / robots.txt (defaults to the request host)
SITE_URL=https://your-domain.example
